                            <Setter Property="FollowWindow" Value="True"/>  
                            <Setter Property="Canvas.Left" Value="16"/>
                            <Setter Property="Canvas.Top" Value="-16"/>
                            <Setter Property="Width" Value="300"/>  
                            <Setter Property="Padding" Value="8"/>
                        </Style>
                        <Style x:Key="Border_Line" TargetType="Border">
                            <Setter Property="Background" Value="Gray"/>
                            <Setter Property="Margin" Value="0,8,0,8"/>
                            <Setter Property="Height" Value=".25"/>
                        </Style>
                        <Style x:Key="Canvas_Button" TargetType="Canvas">  
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Setter Property="Grid.Column" Value="2"/>
                        </Style>
                        <Style x:Key="ScrollViewer_Button" TargetType="local:ResponsiveScrollViewer">
                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>        
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                            <Setter Property="NewHorizontalVisibility" Value="Disabled"/>
                            <Setter Property="NewVerticalVisibility" Value="Hidden"/>
                            <Setter Property="FollowWindow" Value="True"/>
