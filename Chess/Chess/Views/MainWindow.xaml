                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                                <ContentPresenter/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#15AAAAAA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="CollapsedGrid_Button" TargetType="local:CollapsedGrid"> 
                            <Setter Property="NewVisibility" Value="Collapsed"/>
                            <Setter Property="WidthResponsive" Value="1300"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="FollowWindow" Value="True"/>
                            <Setter Property="Grid.Column" Value="1"/>
                        </Style>
                        <Style x:Key="Text_Button" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>  
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Margin" Value="12,0,0,0"/>   
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>
                        <Style x:Key="Border_Button" TargetType="local:AutoInsideBorder">
                            <Setter Property="Background" Value="#1E1D1A"/>
